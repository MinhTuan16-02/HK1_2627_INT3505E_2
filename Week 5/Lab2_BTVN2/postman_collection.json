              "    ]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter genre=tech",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=offset&genre=tech&limit=20"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Technology filter returns 6 books\", function () {",
              "    pm.expect(obj.pagination.total).to.eql(6);",
              "    pm.expect(obj.data.length).to.eql(6);",
              "});",
              "",
              "pm.test(\"All books have genre tech\", function () {",
              "    pm.expect(obj.data.every(x => x.category.slug === \"tech\")).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter category=1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=offset&category=1&limit=20"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Category 1 contains 6 books\", function () {",
              "    pm.expect(obj.pagination.total).to.eql(6);",
              "    pm.expect(obj.data.length).to.eql(6);",
              "});",
