{
  "info": {
    "name": "INT3505E Week 5 - Lab2 & BTVN2 Bookstore API",
    "description": "Offset pagination, cursor pagination, filtering and deterministic multi-key sorting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001",
      "type": "string"
    },
    {
      "key": "cursorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "page1Ids",
      "value": "[]",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Cursor - first page, sort=-id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=3&sort=-id"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Response has data and page\", function () {",
              "    pm.expect(obj).to.have.property(\"data\");",
              "    pm.expect(obj).to.have.property(\"page\");",
              "    pm.expect(obj.data).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"First page contains 3 books\", function () {",
              "    pm.expect(obj.data.length).to.eql(3);",
              "});",
              "",
              "pm.test(\"Default descending id order is correct\", function () {",
              "    pm.expect(obj.data.map(x => x.id)).to.eql([\"book_12\", \"book_11\", \"book_10\"]);",
              "});",
              "",
              "pm.test(\"Next cursor exists\", function () {",
              "    pm.expect(obj.page.more).to.eql(true);",
              "    pm.expect(obj.page.next).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Offset - first 5",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=offset&offset=0&limit=5&sort=id"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Offset pagination structure is correct\", function () {",
              "    pm.expect(obj.data).to.be.an(\"array\");",
              "    pm.expect(obj.pagination.offset).to.eql(0);",
              "    pm.expect(obj.pagination.limit).to.eql(5);",
              "    pm.expect(obj.pagination.total).to.eql(12);",
              "    pm.expect(obj.pagination.has_next).to.eql(true);",
              "});",
              "",
              "pm.test(\"First five ids are correct\", function () {",
              "    pm.expect(obj.data.map(x => x.id)).to.eql([",
              "        \"book_1\", \"book_2\", \"book_3\", \"book_4\", \"book_5\"",
              "    ]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Offset - next 5",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=offset&offset=5&limit=5&sort=id"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Offset metadata is correct\", function () {",
              "    pm.expect(obj.pagination.offset).to.eql(5);",
              "    pm.expect(obj.pagination.limit).to.eql(5);",
              "    pm.expect(obj.pagination.total).to.eql(12);",
              "    pm.expect(obj.pagination.has_next).to.eql(true);",
              "});",
              "",
              "pm.test(\"Second page begins at book_6\", function () {",
              "    pm.expect(obj.data.map(x => x.id)).to.eql([",
