    {
      "name": "Multi-key sort -price,title",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=cursor&genre=tech&sort=-price,title&limit=6"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Six technology books returned\", function () {",
              "    pm.expect(obj.data.length).to.eql(6);",
              "});",
              "",
              "pm.test(\"Sorted by price DESC then title ASC\", function () {",
              "    for (let i = 1; i < obj.data.length; i++) {",
              "        const prev = obj.data[i - 1];",
              "        const curr = obj.data[i];",
              "        pm.expect(prev.price.amount).to.be.at.least(curr.price.amount);",
              "        if (prev.price.amount === curr.price.amount) {",
              "            pm.expect(prev.title.localeCompare(curr.title)).to.be.at.most(0);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Multi-key sort price,-id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=cursor&sort=price,-id&limit=12"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Sorted by price ASC and id DESC on ties\", function () {",
              "    for (let i = 1; i < obj.data.length; i++) {",
              "        const prev = obj.data[i - 1];",
              "        const curr = obj.data[i];",
              "        pm.expect(prev.price.amount).to.be.at.most(curr.price.amount);",
              "        if (prev.price.amount === curr.price.amount) {",
              "            const prevId = Number(prev.id.split(\"_\")[1]);",
              "            const currId = Number(curr.id.split(\"_\")[1]);",
              "            pm.expect(prevId).to.be.at.least(currId);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cursor - page 1 (store cursor and ids)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=cursor&genre=tech&sort=-price,title&limit=2"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Page 1 status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "",
              "pm.test(\"Page 1 contains two books\", function () {",
              "    pm.expect(obj.data.length).to.eql(2);",
              "});",
              "",
              "pm.test(\"Next cursor exists\", function () {",
              "    pm.expect(obj.page.more).to.eql(true);",
              "    pm.expect(obj.page.next).to.be.a(\"string\");",
              "});",
              "",
              "pm.collectionVariables.set(\"cursorToken\", obj.page.next);",
              "pm.collectionVariables.set(\"page1Ids\", JSON.stringify(obj.data.map(x => x.id)));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cursor - page 2 (uses stored cursor)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/books?strategy=cursor&genre=tech&sort=-price,title&limit=2&cursor={{cursorToken}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Page 2 status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const obj = pm.response.json();",
              "const page1Ids = JSON.parse(pm.collectionVariables.get(\"page1Ids\") || \"[]\");",
              "const page2Ids = obj.data.map(x => x.id);",
              "",
              "pm.test(\"Page 2 contains data\", function () {",
              "    pm.expect(page2Ids.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Page 1 and page 2 do not overlap\", function () {",
              "    const overlap = page2Ids.filter(id => page1Ids.includes(id));",
              "    pm.expect(overlap).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
