{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/library/schemas/book.json",
  "title": "Library Book API representation",
  "description": "Public read representation for a catalog title; not a DB table dump.",
  "type": "object",
  "required": ["id", "title", "isbn", "category", "authors", "copiesAvailable", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^book_[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "isbn": {"type": "string", "pattern": "^[0-9]{13}$"},
    "description": {"type": "string", "maxLength": 3000},
    "category": {"$ref": "#/$defs/category"},
    "authors": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/author"}
    },
    "copiesAvailable": {"type": "integer", "minimum": 0},
    "publishedAt": {"type": ["string", "null"], "format": "date"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "category": {
      "type": "object", "required": ["id", "name", "slug"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^category_[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "author": {
      "type": "object", "required": ["id", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^author_[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["lead", "co", "ed"]}
      }
    }
  }
}
