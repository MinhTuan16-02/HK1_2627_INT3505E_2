{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/library/schemas/loan.json",
  "title": "Library Loan API representation",
  "description": "Independent loan resource; references a Member and a physical BookCopy.",
  "type": "object",
  "required": ["id", "memberId", "copyId", "borrowedAt", "dueAt", "status", "returnedAt"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^loan_[1-9][0-9]*$"},
    "memberId": {"type": "string", "pattern": "^member_[1-9][0-9]*$"},
    "copyId": {"type": "string", "pattern": "^copy_[1-9][0-9]*$"},
    "borrowedAt": {"type": "string", "format": "date-time"},
    "dueAt": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["active", "overdue", "returned"]},
    "returnedAt": {"type": ["string", "null"], "format": "date-time"},
    "fine": {
      "type": "object",
      "required": ["amount", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount": {"type": "integer", "minimum": 0},
        "currency": {"const": "VND"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "returned"}}, "required": ["status"]},
      "then": {"properties": {"returnedAt": {"type": "string"}}},
      "else": {"properties": {"returnedAt": {"type": "null"}}}
    }
  ]
}
